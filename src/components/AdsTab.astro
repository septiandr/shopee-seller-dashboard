---
import { 
  Target, 
  RefreshCw, 
  CreditCard, 
  Wallet, 
  ShoppingCart, 
  Zap, 
  Percent, 
  UserCheck, 
  BarChart2, 
  Activity, 
  Layers 
} from 'lucide-astro';
---

<div id="tabContentAds" class="space-y-6 hidden">
  
  <!-- Top Action Bar for Ads -->
  <div class="flex flex-wrap items-center justify-between gap-4 p-5 rounded-2xl bg-gradient-to-r from-orange-500/10 via-orange-50/60 to-white border border-orange-200/80 shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-orange-600 text-white flex items-center justify-center shadow-sm shadow-orange-600/25 shrink-0">
        <Target class="w-5 h-5 stroke-[2.2]" />
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight">
          Evaluasi Efektivitas Iklan Shopee (GMV Max ROAS)
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Data tersinkron otomatis dari file CSV di folder <code class="text-amber-800 font-semibold font-mono text-[11px]">~/Downloads/iklan/</code>.</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a href="https://seller.shopee.co.id/portal/marketing/pas/index?source_page_id=1&view_mode=classic&type=new_cpc_homepage" 
         target="_blank" 
         rel="noopener noreferrer" 
         onclick="openShopeePage('ads', event)"
         class="btn-tactile flex items-center gap-2 ps-3 pe-4 py-2 text-xs font-bold rounded-xl bg-orange-600 text-white hover:bg-orange-700 shadow-sm shadow-orange-500/25"
         title="Buka Halaman Iklan Shopee di Brave Browser (Profile: sdrisanggalih)">
        <Target class="w-4 h-4" />
        <span>Buka Shopee Iklan</span>
      </a>
      <button onclick="syncAdsData()" class="btn-tactile flex items-center gap-2 ps-3 pe-4 py-2 text-xs font-bold rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm shadow-emerald-600/20">
        <RefreshCw class="w-4 h-4" id="iconSyncAds" />
        <span>Sinkronkan Iklan</span>
      </button>
    </div>
  </div>

  <!-- Ads KPI Summary Cards -->
  <section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5">
    
    <!-- Total Biaya Iklan -->
    <div class="card-clean p-4 flex flex-col justify-between border-rose-200/80 bg-rose-50/40">
      <div class="flex items-center justify-between text-rose-700 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">Total Biaya Iklan</span>
        <div class="w-7 h-7 rounded-lg bg-rose-100/80 text-rose-600 flex items-center justify-center border border-rose-200/60">
          <CreditCard class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-rose-600" id="adsTotalSpend">Rp 0</div>
        <p class="text-[10px] text-slate-500 mt-1 font-mono-num" id="adsCampaignCount">0 Laporan</p>
      </div>
    </div>

    <!-- Omzet dari Iklan -->
    <div class="card-clean p-4 flex flex-col justify-between border-blue-200/80 bg-blue-50/30">
      <div class="flex items-center justify-between text-blue-700 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">Omzet Iklan (GMV)</span>
        <div class="w-7 h-7 rounded-lg bg-blue-100/80 text-blue-600 flex items-center justify-center border border-blue-200/60">
          <Wallet class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-blue-700" id="adsTotalGmv">Rp 0</div>
        <p class="text-[10px] text-slate-500 mt-1">Penjualan Iklan</p>
      </div>
    </div>

    <!-- Unit Terjual -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">Produk Terjual</span>
        <div class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center border border-purple-200/60">
          <ShoppingCart class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-slate-900" id="adsTotalUnits">0 Unit</div>
        <p class="text-[10px] text-slate-500 mt-1 font-mono-num" id="adsTotalConversions">0 Pesanan Konversi</p>
      </div>
    </div>

    <!-- ROAS Keseluruhan -->
    <div class="card-hero-light p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-amber-800 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">ROAS Rata-rata</span>
        <div class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center shadow-xs">
          <Zap class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-2xl font-black font-mono-num tracking-tight text-amber-700" id="adsOverallRoas">0.00x</div>
        <p class="text-[10px] text-amber-800/80 mt-1 font-medium">Efektivitas Biaya Iklan</p>
      </div>
    </div>

    <!-- ACOS Keseluruhan -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">ACOS (%)</span>
        <div class="w-7 h-7 rounded-lg bg-cyan-50 text-cyan-600 flex items-center justify-center border border-cyan-200/60">
          <Percent class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-slate-800" id="adsOverallAcos">0.0%</div>
        <p class="text-[10px] text-slate-500 mt-1">Biaya / Omzet</p>
      </div>
    </div>

    <!-- CPC & CPA -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">Biaya / Konversi</span>
        <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-200/60">
          <UserCheck class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-emerald-700" id="adsOverallCpa">Rp 0</div>
        <p class="text-[10px] text-slate-500 mt-1">CPC: <b id="adsOverallCpc" class="text-slate-700 font-mono-num">Rp 0</b></p>
      </div>
    </div>

  </section>

  <!-- Visual Charts for Ads -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- 1. ROAS vs Penjualan -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <BarChart2 class="w-4 h-4 text-amber-500" />
            Grafik ROAS vs Penjualan yang Didapat
          </h2>
          <p class="text-xs text-slate-500">Korelasi level ROAS dan jumlah unit terjual</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 font-bold border border-amber-200/80">ROAS vs Qty</span>
      </div>
      <div class="h-64 relative">
        <canvas id="adsRoasSalesChart"></canvas>
      </div>
    </div>

    <!-- 2. Tren Biaya vs Omzet Iklan per Periode -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <Activity class="w-4 h-4 text-blue-500" />
            Tren Performa per Periode Iklan
          </h2>
          <p class="text-xs text-slate-500">Perbandingan Biaya Iklan, Omzet GMV, dan ROAS</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold border border-blue-200/80">Periode History</span>
      </div>
      <div class="h-64 relative">
        <canvas id="adsPeriodTrendChart"></canvas>
      </div>
    </div>

  </section>

  <!-- Ads Ledger Table with Target ROAS Setting -->
  <section class="card-clean overflow-hidden shadow-sm">
    <div class="px-5 py-4 border-b border-slate-200/80 flex flex-wrap items-center justify-between gap-3 bg-slate-50/70">
      <div>
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <Layers class="w-4 h-4 text-amber-500" />
          Riwayat Iklan & Evaluasi Target ROAS per Produk
        </h2>
        <p class="text-xs text-slate-500">Ketik angka Target ROAS pada baris produk untuk langsung mengevaluasi ketercapaian</p>
      </div>

      <!-- Filter Periode Iklan -->
      <div class="flex items-center gap-2">
        <select id="filterAdsPeriod" onchange="loadAdsData()" class="text-xs bg-white border border-slate-200/90 text-slate-700 rounded-lg px-3 py-2 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-xs">
          <option value="all">Semua Periode Iklan</option>
        </select>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-100/80 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
            <th class="py-3.5 px-4">Periode Tanggal</th>
            <th class="py-3.5 px-4">Nama Produk & Campaign</th>
            <th class="py-3.5 px-3 text-center">Tayangan / Klik</th>
            <th class="py-3.5 px-3 text-center">CTR</th>
            <th class="py-3.5 px-4 text-right">Biaya Iklan</th>
            <th class="py-3.5 px-4 text-right">Omzet GMV</th>
            <th class="py-3.5 px-3 text-center">Unit</th>
            <th class="py-3.5 px-3 text-center">ROAS Real</th>
            <th class="py-3.5 px-4 text-center">Target ROAS</th>
            <th class="py-3.5 px-3 text-center">Evaluasi Target</th>
            <th class="py-3.5 px-3 text-center">ACOS</th>
          </tr>
        </thead>
        <tbody id="adsTableBody" class="divide-y divide-slate-100 text-slate-800 bg-white">
          <tr>
            <td colspan="11" class="py-8 text-center text-slate-400">Memuat data iklan...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

</div>
