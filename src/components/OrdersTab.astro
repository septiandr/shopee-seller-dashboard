---
import QuickInsights from './QuickInsights.astro';
import { 
  ShoppingBag, 
  Scissors, 
  Wallet, 
  Package, 
  Sparkles, 
  PackageCheck, 
  CalendarDays, 
  Clock, 
  LineChart, 
  MapPin, 
  Crown, 
  Layers, 
  Search, 
  Table, 
  Printer, 
  FolderClock, 
  Tag, 
  ExternalLink 
} from 'lucide-astro';
---

<div id="tabContentOrders" class="space-y-6">
  
  <!-- Clean Tab Header (Bebas dari Banner Menabrak & Duplikasi Tombol) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1 border-b border-slate-200/60">
    <div>
      <h2 class="text-base sm:text-lg font-extrabold text-slate-900 tracking-tight">
        Analitik Pesanan & Penjualan
      </h2>
      <p class="text-xs text-slate-500">Performa harian, omzet kotor, potongan admin Shopee, modal HPP, dan laba bersih.</p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto text-xs">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-50 text-amber-800 border border-amber-200/80 font-semibold font-mono-num">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span id="badgeResiCountTab">0</span> Resi Aktif
      </span>
    </div>
  </div>

  <!-- Quick Insights Section -->
  <QuickInsights />

  <!-- Overview Metric Cards (KPI Cards) -->
  <section class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3.5">
    
    <!-- Subtotal Omzet -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Subtotal Omzet</span>
        <div class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-200/60">
          <ShoppingBag class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-slate-900" id="statOmzet">Rp 0</div>
        <p class="text-[11px] text-slate-500 mt-1 font-medium flex items-center gap-1.5" id="statOrdersCount">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> 0 Transaksi
        </p>
      </div>
    </div>

    <!-- Potongan Shopee -->
    <div class="card-clean p-4 flex flex-col justify-between border-rose-200/80 bg-rose-50/40">
      <div class="flex items-center justify-between text-rose-600 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-rose-700">Potongan Shopee</span>
        <div class="w-7 h-7 rounded-lg bg-rose-100/80 text-rose-600 flex items-center justify-center border border-rose-200/60">
          <Scissors class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-rose-600" id="statShopeeDeductions">-Rp 0</div>
        <p class="text-[10px] text-slate-500 mt-1">17.58% + Rp 1.250</p>
      </div>
    </div>

    <!-- Cair dari Shopee -->
    <div class="card-clean p-4 flex flex-col justify-between border-blue-200/80 bg-blue-50/30">
      <div class="flex items-center justify-between text-blue-700 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-blue-700">Pencairan Shopee</span>
        <div class="w-7 h-7 rounded-lg bg-blue-100/80 text-blue-600 flex items-center justify-center border border-blue-200/60">
          <Wallet class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-blue-700" id="statNetPayout">Rp 0</div>
        <p class="text-[11px] text-slate-500 mt-1">Masuk Saldo Penjual</p>
      </div>
    </div>

    <!-- Total Modal HPP -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Modal HPP</span>
        <div class="w-7 h-7 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center border border-orange-200/60">
          <Package class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-slate-800" id="statTotalHpp">Rp 0</div>
        <p class="text-[10px] text-slate-500 mt-1 flex justify-between">
          <span>Cov: <b id="subHppCover" class="text-slate-700 font-mono-num">Rp 0</b></span>
          <span>Baut: <b id="subHppBolt" class="text-slate-700 font-mono-num">Rp 0</b></span>
        </p>
      </div>
    </div>

    <!-- HERO: Laba Bersih Real -->
    <div class="card-hero-light p-4 flex flex-col justify-between relative overflow-hidden">
      <div class="flex items-center justify-between text-amber-800 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider">Laba Bersih Real</span>
        <div class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center shadow-xs">
          <Sparkles class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-2xl font-black font-mono-num tracking-tight text-emerald-700" id="statProfit">Rp 0</div>
        <div class="flex items-center gap-1.5 text-[11px] mt-1 font-semibold">
          <span class="px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 font-bold font-mono-num" id="statMargin">0%</span>
          <span class="text-slate-600">Margin Real</span>
        </div>
      </div>
    </div>

    <!-- Unit Terjual -->
    <div class="card-clean p-4 flex flex-col justify-between">
      <div class="flex items-center justify-between text-slate-500 mb-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Unit Terjual</span>
        <div class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center border border-purple-200/60">
          <PackageCheck class="w-3.5 h-3.5" />
        </div>
      </div>
      <div>
        <div class="text-xl font-black font-mono-num tracking-tight text-slate-900">
          <span id="statCoverQty">0</span> <span class="text-xs font-normal text-slate-500">cov</span> / 
          <span id="statBoltQty" class="text-amber-600 font-bold">0</span> <span class="text-xs font-normal text-slate-500">baut</span>
        </div>
        <p class="text-[11px] text-slate-500 mt-1 font-mono-num" id="statAvgProfit">Rata-rata: Rp 0/ord</p>
      </div>
    </div>

  </section>

  <!-- 4 GRAFIK UTAMA: HARI, JAM, BULAN, KOTA -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- 1. Hari Terlaris -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <CalendarDays class="w-4 h-4 text-amber-500" />
            Grafik Hari Terlaris (Senin – Minggu)
          </h2>
          <p class="text-xs text-slate-500">Volume pesanan & garis laba bersih tiap hari</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 font-bold border border-amber-200/80 font-mono-num" id="badgeBestDayHeader">-</span>
      </div>
      <div class="h-60 relative">
        <canvas id="dayOfWeekChart"></canvas>
      </div>
    </div>

    <!-- 2. Jam Terlaris -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <Clock class="w-4 h-4 text-blue-500" />
            Grafik Jam Terlaris (Peak Order Hours)
          </h2>
          <p class="text-xs text-slate-500">Waktu transaksi dari 00:00 s/d 23:00 WIB</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold border border-blue-200/80 font-mono-num" id="badgeBestHourHeader">-</span>
      </div>
      <div class="h-60 relative">
        <canvas id="hourlyChart"></canvas>
      </div>
    </div>

    <!-- 3. Bulanan -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <LineChart class="w-4 h-4 text-purple-500" />
            Grafik Penjualan Bulanan
          </h2>
          <p class="text-xs text-slate-500">Performa omzet dan laba per bulan</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-purple-50 text-purple-700 font-bold border border-purple-200/80 font-mono-num" id="badgeBestMonthHeader">-</span>
      </div>
      <div class="h-60 relative">
        <canvas id="monthlyChart"></canvas>
      </div>
    </div>

    <!-- 4. Kota Terlaris -->
    <div class="card-clean p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <MapPin class="w-4 h-4 text-emerald-500" />
            Grafik Kota / Kabupaten Terlaris
          </h2>
          <p class="text-xs text-slate-500">Peringkat wilayah tujuan pengiriman tertinggi</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 font-bold border border-emerald-200/80 font-mono-num" id="badgeBestCityHeader">-</span>
      </div>
      <div class="h-60 relative">
        <canvas id="cityChart"></canvas>
      </div>
    </div>

  </section>

  <!-- SECTION: PRODUK & VARIAN TERLARIS (TOP SELLERS BREAKDOWN) -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Kolom 1: Peringkat Produk Terlaris -->
    <div class="card-clean p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <Crown class="w-4 h-4 text-amber-500" />
              Peringkat Produk Terlaris
            </h2>
            <p class="text-xs text-slate-500">Berdasarkan total volume unit & kontribusi omzet</p>
          </div>
          <span class="text-xs px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 font-bold border border-amber-200/80 font-mono-num" id="badgeTopProductCount">0 Produk</span>
        </div>
        
        <div class="space-y-3 mt-4" id="topProductsList">
          <div class="py-6 text-center text-xs text-slate-400">Memuat peringkat produk...</div>
        </div>
      </div>

      <!-- Quick Summary Footer: Model New vs Model Old -->
      <div class="mt-5 pt-3.5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="text-slate-500 font-semibold">Distribusi Model:</span>
        <div class="flex items-center gap-2" id="modelSummaryPills"></div>
      </div>
    </div>

    <!-- Kolom 2: Peringkat Variasi Terlaris -->
    <div class="card-clean p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <Layers class="w-4 h-4 text-cyan-600" />
              Peringkat Variasi Terlaris
            </h2>
            <p class="text-xs text-slate-500">Rincian spesifik varian (Model + Baut / Tanpa Baut)</p>
          </div>
          <span class="text-xs px-2.5 py-1 rounded-lg bg-cyan-50 text-cyan-700 font-bold border border-cyan-200/80 font-mono-num" id="badgeTopVariantCount">0 Variasi</span>
        </div>
        
        <div class="space-y-3 mt-4" id="topVariantsList">
          <div class="py-6 text-center text-xs text-slate-400">Memuat peringkat variasi...</div>
        </div>
      </div>

      <!-- Quick Summary Footer: Dengan Baut vs Tanpa Baut -->
      <div class="mt-5 pt-3.5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="text-slate-500 font-semibold">Distribusi Baut:</span>
        <div class="flex items-center gap-2" id="boltSummaryPills"></div>
      </div>
    </div>

  </section>

  <!-- Filters & Search Toolbar (Terstruktur 2 Baris, Anti-Tabrakan) -->
  <section class="card-clean p-4 space-y-3">
    <!-- Baris 1: Filter Periode & Pencarian Cepat -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <!-- Period Segmented Buttons -->
      <div class="inline-flex items-center bg-slate-100/90 p-1 rounded-xl border border-slate-200/80 text-xs gap-0.5 shadow-inner overflow-x-auto">
        <button onclick="setPeriod('all')" class="period-btn px-3 py-1.5 rounded-lg font-bold text-slate-900 bg-white shadow-xs" data-period="all">Semua</button>
        <button onclick="setPeriod('today')" class="period-btn px-3 py-1.5 rounded-lg font-medium text-slate-600 hover:text-slate-900" data-period="today">Hari Ini</button>
        <button onclick="setPeriod('yesterday')" class="period-btn px-3 py-1.5 rounded-lg font-medium text-slate-600 hover:text-slate-900" data-period="yesterday">Kemarin</button>
        <button onclick="setPeriod('7days')" class="period-btn px-3 py-1.5 rounded-lg font-medium text-slate-600 hover:text-slate-900" data-period="7days">7 Hari</button>
        <button onclick="setPeriod('30days')" class="period-btn px-3 py-1.5 rounded-lg font-medium text-slate-600 hover:text-slate-900" data-period="30days">30 Hari</button>
      </div>

      <!-- Quick Search Bar -->
      <div class="relative w-full sm:w-72">
        <Search class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input type="text" id="searchInput" oninput="debounceSearch()" placeholder="Cari pesanan, resi, kota, jam..." class="w-full text-xs bg-white border border-slate-200/90 text-slate-900 pl-9 pr-3 py-2 rounded-xl outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 placeholder:text-slate-400 shadow-xs">
      </div>
    </div>

    <!-- Baris 2: Filter Dropdown Grid (Presisi 4 Kolom) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 pt-3 border-t border-slate-100">
      <select id="filterBolt" onchange="applyFilters()" class="text-xs bg-white border border-slate-200/90 text-slate-700 rounded-xl px-3 py-2 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-xs">
        <option value="all">Semua Varian Baut</option>
        <option value="1">🔩 Dengan Baut (+ Rp 2.000)</option>
        <option value="0">🛡️ Tanpa Baut</option>
      </select>

      <select id="filterModel" onchange="applyFilters()" class="text-xs bg-white border border-slate-200/90 text-slate-700 rounded-xl px-3 py-2 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-xs">
        <option value="all">Semua Model</option>
        <option value="Model Old">Model Old</option>
        <option value="Model New">Model New</option>
      </select>

      <select id="filterProvince" onchange="applyFilters()" class="text-xs bg-white border border-slate-200/90 text-slate-700 rounded-xl px-3 py-2 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-xs">
        <option value="all">📍 Semua Provinsi</option>
      </select>

      <select id="filterStatus" onchange="applyFilters()" class="text-xs bg-white border border-slate-200/90 text-slate-700 rounded-xl px-3 py-2 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-xs">
        <option value="all">Semua Status</option>
        <option value="Sedang Dikirim">Sedang Dikirim</option>
        <option value="Telah Dikirim">Telah Dikirim</option>
        <option value="Selesai">Selesai</option>
        <option value="Batal">Batal</option>
      </select>
    </div>
  </section>

  <!-- Orders Data Table -->
  <section class="card-clean overflow-hidden shadow-sm">
    <div class="px-5 py-4 border-b border-slate-200/80 flex items-center justify-between bg-slate-50/70">
      <div>
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <Table class="w-4 h-4 text-amber-500" />
          Rincian Pembukuan Transaksi
        </h2>
        <p class="text-xs text-slate-500 font-mono-num" id="tableRecordCount">Menampilkan 0 transaksi</p>
      </div>
      <div class="text-xs text-slate-500 flex items-center gap-3 font-medium">
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Dengan Baut</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Tanpa Baut</span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-100/80 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
            <th class="py-3.5 px-4">No. Pesanan & Resi</th>
            <th class="py-3.5 px-4">🕒 Jam & Tanggal</th>
            <th class="py-3.5 px-4">📍 Lokasi Pengiriman</th>
            <th class="py-3.5 px-4">Model & Variasi</th>
            <th class="py-3.5 px-3 text-center">Qty</th>
            <th class="py-3.5 px-4 text-right">Subtotal</th>
            <th class="py-3.5 px-4 text-right text-rose-600">Potongan</th>
            <th class="py-3.5 px-4 text-right text-blue-700">Cair Shopee</th>
            <th class="py-3.5 px-4 text-right text-slate-700">Modal HPP</th>
            <th class="py-3.5 px-4 text-right text-emerald-700">Laba Real</th>
            <th class="py-3.5 px-3 text-center">Margin</th>
            <th class="py-3.5 px-3 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="ordersTableBody" class="divide-y divide-slate-100 text-slate-800 bg-white">
          <tr>
            <td colspan="12" class="py-8 text-center text-slate-400">Memuat data transaksi...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="px-5 py-3.5 border-t border-slate-200/80 bg-slate-50/70 flex items-center justify-between text-xs text-slate-500">
      <span id="paginationInfo" class="font-medium font-mono-num">Halaman 1 dari 1</span>
      <div class="flex items-center gap-2">
        <button id="btnPrevPage" onclick="prevPage()" class="btn-tactile px-3 py-1.5 rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none shadow-xs font-semibold">Sebelumnya</button>
        <button id="btnNextPage" onclick="nextPage()" class="btn-tactile px-3 py-1.5 rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none shadow-xs font-semibold">Berikutnya</button>
      </div>
    </div>
  </section>

</div>
