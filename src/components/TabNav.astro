---
import { Receipt, Calculator, Target } from 'lucide-astro';
---

<div class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-16 z-30 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-3">
    
    <!-- Segmented Navigation Dock -->
    <div class="inline-flex items-center bg-slate-100/90 p-1 rounded-2xl border border-slate-200/80 gap-1 overflow-x-auto max-w-full shadow-inner">
      <button onclick="switchTab('orders')" id="tabBtnOrders" class="btn-tactile px-3.5 sm:px-4 py-1.5 text-xs sm:text-sm font-bold rounded-xl bg-white text-slate-900 shadow-sm border border-slate-200/90 flex items-center gap-2 transition-all whitespace-nowrap">
        <Receipt class="w-4 h-4 text-amber-600" />
        <span>Pesanan & Penjualan</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold font-mono-num" id="badgeOrdersTabCount">0</span>
      </button>

      <button onclick="switchTab('bookkeeping')" id="tabBtnBookkeeping" class="btn-tactile px-3.5 sm:px-4 py-1.5 text-xs sm:text-sm font-semibold rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 flex items-center gap-2 transition-all whitespace-nowrap">
        <Calculator class="w-4 h-4 text-emerald-600" />
        <span>Pembukuan (P&L)</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-bold font-mono-num">Laba Bersih</span>
      </button>

      <button onclick="switchTab('ads')" id="tabBtnAds" class="btn-tactile px-3.5 sm:px-4 py-1.5 text-xs sm:text-sm font-semibold rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 flex items-center gap-2 transition-all whitespace-nowrap">
        <Target class="w-4 h-4 text-orange-600" />
        <span>Iklan & ROAS</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-orange-100 text-orange-800 font-bold font-mono-num">GMV Max</span>
      </button>
    </div>

    <!-- Quick Micro Stats Bar (Layar Besar) -->
    <div class="hidden lg:flex items-center gap-2.5 text-xs">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200/80 text-slate-600 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Auto-Sync Folder</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50/70 border border-indigo-200/70 text-indigo-700 font-medium">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
        <span>Printer: <strong class="text-indigo-900 font-mono">80mm Roll</strong></span>
      </div>
    </div>

  </div>
</div>
