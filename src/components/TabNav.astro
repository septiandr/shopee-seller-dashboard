---
import { Receipt, Calculator, Target } from 'lucide-astro';
---

<div class="border-b border-slate-200 bg-white sticky top-16 z-30 shadow-[0_1px_2px_0_rgba(15,23,42,0.02)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-6 overflow-x-auto">
    <button onclick="switchTab('orders')" id="tabBtnOrders" class="py-3.5 px-1 text-xs sm:text-sm font-bold border-b-2 border-amber-500 text-amber-600 flex items-center gap-2 transition-colors whitespace-nowrap">
      <Receipt class="w-4 h-4" />
      <span>Penjualan & Pesanan</span>
      <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold font-mono-num" id="badgeOrdersTabCount">0</span>
    </button>

    <button onclick="switchTab('bookkeeping')" id="tabBtnBookkeeping" class="py-3.5 px-1 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-900 flex items-center gap-2 transition-colors whitespace-nowrap">
      <Calculator class="w-4 h-4" />
      <span>Pembukuan & Biaya Operasional</span>
      <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-bold">P&L</span>
    </button>

    <button onclick="switchTab('ads')" id="tabBtnAds" class="py-3.5 px-1 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-900 flex items-center gap-2 transition-colors whitespace-nowrap">
      <Target class="w-4 h-4" />
      <span>Performa Iklan & Target ROAS</span>
      <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold">Auto</span>
    </button>
  </div>
</div>
