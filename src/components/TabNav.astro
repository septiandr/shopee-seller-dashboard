---
import { Receipt, Calculator, Target } from 'lucide-astro';
---

<div class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-16 z-30 shadow-[0_1px_2px_0_rgba(15,23,42,0.02)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3">
    
    <!-- Segmented Navigation Dock -->
    <div class="inline-flex items-center bg-slate-100/90 p-1 rounded-2xl border border-slate-200/80 gap-1 overflow-x-auto max-w-full shadow-inner">
      <button onclick="switchTab('orders')" id="tabBtnOrders" class="btn-tactile px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-bold rounded-xl bg-white text-slate-900 shadow-sm border border-slate-200/90 flex items-center gap-2 transition-all whitespace-nowrap">
        <Receipt class="w-4 h-4 text-amber-600" />
        <span>Penjualan & Pesanan</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold font-mono-num" id="badgeOrdersTabCount">0</span>
      </button>

      <button onclick="switchTab('bookkeeping')" id="tabBtnBookkeeping" class="btn-tactile px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 flex items-center gap-2 transition-all whitespace-nowrap">
        <Calculator class="w-4 h-4 text-emerald-600" />
        <span>Pembukuan & Biaya Operasional</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-emerald-100 text-emerald-800 font-bold font-mono-num">P&L</span>
      </button>

      <button onclick="switchTab('ads')" id="tabBtnAds" class="btn-tactile px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl text-slate-600 hover:text-slate-900 hover:bg-white/60 flex items-center gap-2 transition-all whitespace-nowrap">
        <Target class="w-4 h-4 text-orange-600" />
        <span>Performa Iklan & ROAS</span>
        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-amber-100 text-amber-800 font-bold font-mono-num">Auto</span>
      </button>
    </div>

    <!-- Quick Micro Stats Bar -->
    <div class="hidden lg:flex items-center gap-2.5 text-xs">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/70 border border-slate-200/70 text-slate-600 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Auto-Sync: <strong class="text-slate-800">Aktif</strong></span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50/80 border border-indigo-200/70 text-indigo-700 font-medium">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
        <span>Thermal 80mm: <strong class="text-indigo-900">RPP02N</strong></span>
      </div>
    </div>

  </div>
</div>
