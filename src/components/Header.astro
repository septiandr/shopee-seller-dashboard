---
import { 
  ShieldCheck, 
  ShoppingBag, 
  Target, 
  Wallet, 
  RefreshCw, 
  Upload, 
  Sliders, 
  Download, 
  Tag, 
  Printer, 
  FolderClock 
} from 'lucide-astro';
---

<header class="border-b border-slate-200/80 bg-white/95 backdrop-blur-md sticky top-0 z-40 shadow-[0_1px_3px_0_rgba(15,23,42,0.03)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Brand & Shop Identity -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 text-white flex items-center justify-center font-black shadow-md shadow-amber-500/20 shrink-0">
        <ShieldCheck class="w-5 h-5 stroke-[2.5]" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900">Shopee Ledger & Ads</h1>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200/80">Cover Knalpot</span>
        </div>
        <p class="text-[11px] text-slate-500 flex items-center gap-1.5 mt-0.5 font-medium">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Pembukuan HPP Otomatis & ROAS Evaluator
        </p>
      </div>
    </div>

    <!-- Action Buttons & Direct Shopee Links -->
    <div class="flex items-center gap-2">
      
      <!-- Direct Shopee Seller Shortcut Buttons -->
      <div class="hidden xl:flex items-center bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80 text-xs">
        <a href="https://seller.shopee.co.id/portal/sale/order" 
           target="_blank" 
           rel="noopener noreferrer" 
           onclick="openShopeePage('order', event)"
           class="btn-tactile ps-2 pe-2.5 py-1.5 rounded-lg text-slate-700 hover:text-amber-700 hover:bg-white font-bold flex items-center gap-1.5" 
           title="Buka Halaman Penjualan / Pesanan Shopee (Brave: sdrisanggalih)">
          <ShoppingBag class="w-3.5 h-3.5 text-amber-600" />
          <span>Penjualan</span>
        </a>

        <a href="https://seller.shopee.co.id/portal/marketing/pas/index?source_page_id=1&view_mode=classic&type=new_cpc_homepage" 
           target="_blank" 
           rel="noopener noreferrer" 
           onclick="openShopeePage('ads', event)"
           class="btn-tactile ps-2 pe-2.5 py-1.5 rounded-lg text-slate-700 hover:text-orange-700 hover:bg-white font-bold flex items-center gap-1.5" 
           title="Buka Halaman Iklan Shopee (Brave: sdrisanggalih)">
          <Target class="w-3.5 h-3.5 text-orange-600" />
          <span>Iklan</span>
        </a>

        <a href="https://seller.shopee.co.id/portal/finance/wallet/shopeepay" 
           target="_blank" 
           rel="noopener noreferrer" 
           onclick="openShopeePage('finance', event)"
           class="btn-tactile ps-2 pe-2.5 py-1.5 rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-white font-bold flex items-center gap-1.5" 
           title="Buka Halaman Pemasukan / Saldo Shopee (Brave: sdrisanggalih)">
          <Wallet class="w-3.5 h-3.5 text-emerald-600" />
          <span>Pemasukan</span>
        </a>
      </div>

      <button id="btnSyncFolder" onclick="syncAllData()" class="btn-tactile flex items-center gap-2 ps-2.5 pe-3.5 py-2 text-xs font-bold rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200/90 hover:bg-emerald-100 shadow-sm" title="Sinkronkan data dari folder">
        <RefreshCw class="w-3.5 h-3.5" id="iconSync" />
        <span class="hidden md:inline">Sinkronkan Folder</span>
      </button>

      <button onclick="openUploadModal()" class="btn-tactile flex items-center gap-2 ps-3 pe-4 py-2 text-xs font-bold rounded-lg bg-amber-500 text-white hover:bg-amber-600 shadow-sm shadow-amber-500/20">
        <Upload class="w-3.5 h-3.5 stroke-[2.5]" />
        <span>Upload File</span>
      </button>

      <button onclick="openSettingsModal()" class="btn-tactile flex items-center gap-2 ps-2.5 pe-3.5 py-2 text-xs font-semibold rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 shadow-sm" title="Pengaturan HPP & Folder">
        <Sliders class="w-3.5 h-3.5 text-slate-500" />
        <span class="hidden sm:inline">HPP</span>
      </button>

      <button onclick="exportExcel()" class="btn-tactile flex items-center gap-2 ps-2.5 pe-3.5 py-2 text-xs font-semibold rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 shadow-sm" title="Download Laporan Excel">
        <Download class="w-3.5 h-3.5 text-slate-500" />
        <span class="hidden sm:inline">Export</span>
      </button>

      <a href="/thermal-card" target="_blank" class="btn-tactile flex items-center gap-2 ps-2.5 pe-3.5 py-2 text-xs font-semibold rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 shadow-sm" title="Cetak Kartu Ucapan / Stiker Thermal Terima Kasih">
        <Tag class="w-3.5 h-3.5 text-slate-500" />
        <span class="hidden lg:inline">Stiker Thermal</span>
      </a>

      <button onclick="directPrintLatestResi()" class="btn-tactile flex items-center gap-2 ps-2.5 pe-3.5 py-2 text-xs font-bold rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm shadow-indigo-500/20" title="Langsung Cetak Resi Terbaru ke Printer 80mm">
        <Printer class="w-3.5 h-3.5 stroke-[2.5]" />
        <span class="hidden sm:inline">Langsung Cetak Resi</span>
        <span id="resiStatusDot" class="w-2 h-2 rounded-full bg-emerald-400 ring-2 ring-indigo-400" title="Resi Printer Siap"></span>
      </button>

      <button onclick="openResiModal()" class="btn-tactile flex items-center gap-1.5 ps-2 pe-3 py-2 text-xs font-semibold rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 shadow-sm" title="Daftar & Upload File Resi">
        <FolderClock class="w-3.5 h-3.5 text-slate-500" />
        <span class="hidden md:inline">Daftar Resi</span>
      </button>
    </div>
  </div>
</header>
