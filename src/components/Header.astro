---
import { 
  ShieldCheck, 
  ShoppingBag, 
  Target, 
  Wallet, 
  RefreshCw, 
  Upload, 
  Sliders, 
  Download, 
  Tag, 
  Printer, 
  FolderClock,
  ChevronDown,
  MoreVertical,
  ExternalLink,
  Zap
} from 'lucide-astro';
---

<header class="border-b border-slate-200/80 bg-white/95 backdrop-blur-md sticky top-0 z-40 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    
    <!-- Brand & Shop Identity (Kiri) -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white flex items-center justify-center font-black shadow-md shadow-amber-500/20 ring-1 ring-white/20 shrink-0">
        <ShieldCheck class="w-5 h-5 stroke-[2.3]" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 leading-tight">Shopee Ledger</span>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200/90 hidden sm:inline-block">Cover Knalpot</span>
        </div>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Auto-Sync Aktif
          </span>
        </div>
      </div>
    </div>

    <!-- Ergonomic Action Cluster (Kanan: Tertata, Rapi & Tidak Menabrak) -->
    <div class="flex items-center gap-2">
      
      <!-- 1. Shopee Seller Center Portal (Dropdown Kompak) -->
      <div class="relative" id="shopeeDropdownContainer">
        <button id="btnShopeeDropdown" 
                type="button"
                onclick="toggleHeaderDropdown('shopeeDropdownMenu')"
                class="btn-tactile flex items-center gap-1.5 px-2.5 sm:px-3 py-2 text-xs font-bold rounded-xl bg-slate-100/90 text-slate-700 hover:text-amber-700 hover:bg-slate-200/80 border border-slate-200/80 shadow-xs">
          <ShoppingBag class="w-3.5 h-3.5 text-amber-600" />
          <span class="hidden sm:inline">Portal Shopee</span>
          <ChevronDown class="w-3 h-3 text-slate-400" />
        </button>

        <div id="shopeeDropdownMenu" class="hidden absolute right-0 mt-1.5 w-56 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-150">
          <div class="px-3 py-1.5 border-b border-slate-100 text-[10px] uppercase font-extrabold text-slate-400 tracking-wider">
            Buka di Brave (sdrisanggalih)
          </div>
          <a href="https://seller.shopee.co.id/portal/sale/order" 
             target="_blank" 
             rel="noopener noreferrer" 
             onclick="openShopeePage('order', event); toggleHeaderDropdown('shopeeDropdownMenu', false);"
             class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-800 transition-colors">
            <ShoppingBag class="w-4 h-4 text-amber-600" />
            <div class="flex-1">
              <div class="font-bold">Pesanan & Penjualan</div>
              <div class="text-[10px] text-slate-400 font-normal">Cek status pengiriman pesanan</div>
            </div>
            <ExternalLink class="w-3 h-3 text-slate-400" />
          </a>
          <a href="https://seller.shopee.co.id/portal/marketing/pas/index?source_page_id=1&view_mode=classic&type=new_cpc_homepage" 
             target="_blank" 
             rel="noopener noreferrer" 
             onclick="openShopeePage('ads', event); toggleHeaderDropdown('shopeeDropdownMenu', false);"
             class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-orange-50 hover:text-orange-800 transition-colors">
            <Target class="w-4 h-4 text-orange-600" />
            <div class="flex-1">
              <div class="font-bold">Iklan Shopee</div>
              <div class="text-[10px] text-slate-400 font-normal">Dashboard iklan GMV Max</div>
            </div>
            <ExternalLink class="w-3 h-3 text-slate-400" />
          </a>
          <a href="https://seller.shopee.co.id/portal/finance/wallet/shopeepay" 
             target="_blank" 
             rel="noopener noreferrer" 
             onclick="openShopeePage('finance', event); toggleHeaderDropdown('shopeeDropdownMenu', false);"
             class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 transition-colors">
            <Wallet class="w-4 h-4 text-emerald-600" />
            <div class="flex-1">
              <div class="font-bold">Pemasukan & Saldo</div>
              <div class="text-[10px] text-slate-400 font-normal">Saldo ShopeePay & penarikan</div>
            </div>
            <ExternalLink class="w-3 h-3 text-slate-400" />
          </a>
        </div>
      </div>

      <!-- 2. Studio Resi & Cetak Thermal (Dropdown Terpadu) -->
      <div class="relative" id="resiDropdownContainer">
        <button id="btnResiDropdown"
                type="button"
                onclick="toggleHeaderDropdown('resiDropdownMenu')"
                class="btn-tactile flex items-center gap-1.5 px-2.5 sm:px-3 py-2 text-xs font-bold rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200/90 shadow-xs">
          <Printer class="w-3.5 h-3.5 stroke-[2.2]" />
          <span>Cetak Resi</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="Printer Siap"></span>
          <ChevronDown class="w-3 h-3 text-indigo-400" />
        </button>

        <div id="resiDropdownMenu" class="hidden absolute right-0 mt-1.5 w-60 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-150">
          <div class="px-3 py-1.5 border-b border-slate-100 text-[10px] uppercase font-extrabold text-slate-400 tracking-wider">
            Thermal 80mm Studio
          </div>
          <button onclick="directPrintLatestResi(); toggleHeaderDropdown('resiDropdownMenu', false);"
                  class="w-full text-left flex items-center gap-2.5 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-800 transition-colors">
            <Zap class="w-4 h-4 text-indigo-600 shrink-0" />
            <div class="flex-1">
              <div class="font-bold flex items-center gap-1.5">
                Langsung Cetak Resi
                <span class="px-1.5 py-0.2 rounded-full text-[9px] bg-indigo-100 text-indigo-700 font-mono">1-Klik</span>
              </div>
              <div class="text-[10px] text-slate-400 font-normal">Cetak file PDF resi terbaru langsung</div>
            </div>
          </button>
          <button onclick="openResiModal(); toggleHeaderDropdown('resiDropdownMenu', false);"
                  class="w-full text-left flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-800 transition-colors">
            <FolderClock class="w-4 h-4 text-indigo-600 shrink-0" />
            <div class="flex-1">
              <div class="font-bold">Daftar & Upload Resi</div>
              <div class="text-[10px] text-slate-400 font-normal">Lihat riwayat PDF & anti-double scan</div>
            </div>
          </button>
          <a href="/thermal-card" 
             target="_blank"
             onclick="toggleHeaderDropdown('resiDropdownMenu', false);"
             class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-800 transition-colors border-t border-slate-100 mt-1 pt-1.5">
            <Tag class="w-4 h-4 text-slate-500 shrink-0" />
            <div class="flex-1">
              <div class="font-bold">Stiker Terima Kasih</div>
              <div class="text-[10px] text-slate-400 font-normal">Desain stiker roll thermal 80mm</div>
            </div>
            <ExternalLink class="w-3 h-3 text-slate-400" />
          </a>
        </div>
      </div>

      <!-- 3. Tombol Sinkronisasi Data Cepat -->
      <button id="btnSyncFolder" 
              onclick="syncAllData()" 
              class="btn-tactile flex items-center gap-1.5 px-2.5 sm:px-3 py-2 text-xs font-bold rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/90 hover:bg-emerald-100 shadow-xs" 
              title="Sinkronkan data dari folder unduhan Shopee">
        <RefreshCw class="w-3.5 h-3.5" id="iconSync" />
        <span class="hidden md:inline">Sinkron Folder</span>
      </button>

      <!-- 4. Menu Alat & Ekspor (Dropdown Opsi Ringkas) -->
      <div class="relative" id="moreDropdownContainer">
        <button id="btnMoreDropdown"
                type="button"
                onclick="toggleHeaderDropdown('moreDropdownMenu')"
                class="btn-tactile p-2 text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 rounded-xl border border-slate-200 shadow-xs"
                title="Pengaturan & Ekspor Laporan">
          <MoreVertical class="w-4 h-4" />
        </button>

        <div id="moreDropdownMenu" class="hidden absolute right-0 mt-1.5 w-52 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-150">
          <button onclick="openSettingsModal(); toggleHeaderDropdown('moreDropdownMenu', false);" 
                  class="w-full text-left flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            <Sliders class="w-4 h-4 text-slate-500" />
            <span>Pengaturan HPP & Biaya</span>
          </button>
          <button onclick="exportExcel(); toggleHeaderDropdown('moreDropdownMenu', false);" 
                  class="w-full text-left flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            <Download class="w-4 h-4 text-slate-500" />
            <span>Export Laporan Excel</span>
          </button>
        </div>
      </div>

      <!-- 5. Upload File (CTA Primer Bersih) -->
      <button onclick="openUploadModal()" 
              class="btn-tactile flex items-center gap-1.5 px-3 sm:px-4 py-2 text-xs font-bold rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-white hover:from-amber-600 hover:to-amber-700 shadow-sm shadow-amber-500/25 shrink-0">
        <Upload class="w-3.5 h-3.5 stroke-[2.5]" />
        <span>Upload</span>
      </button>

    </div>
  </div>
</header>

<script is:inline>
  // Helper dropdown menu header
  function toggleHeaderDropdown(menuId, forceState = null) {
    const menus = ['shopeeDropdownMenu', 'resiDropdownMenu', 'moreDropdownMenu'];
    menus.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      if (id === menuId) {
        if (forceState !== null) {
          if (forceState) el.classList.remove('hidden');
          else el.classList.add('hidden');
        } else {
          el.classList.toggle('hidden');
        }
      } else {
        el.classList.add('hidden');
      }
    });
  }

  // Tutup dropdown saat klik di luar
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#shopeeDropdownContainer') &&
        !e.target.closest('#resiDropdownContainer') &&
        !e.target.closest('#moreDropdownContainer')) {
      toggleHeaderDropdown(null, false);
    }
  });
</script>
