---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TabNav from '../components/TabNav.astro';
import OrdersTab from '../components/OrdersTab.astro';
import BookkeepingTab from '../components/BookkeepingTab.astro';
import AdsTab from '../components/AdsTab.astro';
import Modals from '../components/Modals.astro';
---

<Layout title="Shopee Ledger & Ads - Pembukuan Cover Knalpot & Studio Resi 80mm">
  <!-- Header Bar -->
  <Header />

  <!-- Navigation Tabs -->
  <TabNav />

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed top-20 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Tab 1: Orders & Sales -->
    <OrdersTab />

    <!-- Tab 2: Bookkeeping & P&L -->
    <BookkeepingTab />

    <!-- Tab 3: Ads & ROAS -->
    <AdsTab />
  </main>

  <!-- Modals -->
  <Modals />

  <!-- Inline Bridge & Fallback Script to ensure zero reference errors -->
  <script is:inline>
    // Inlined modal bridge to prevent race condition or cache issues
    window.openResiModal = function() {
      const modal = document.getElementById('resiModal');
      if (modal) {
        modal.classList.remove('hidden');
        if (typeof window.loadResiFiles === 'function') {
          window.loadResiFiles();
        }
      }
    };

    window.closeResiModal = function() {
      const modal = document.getElementById('resiModal');
      if (modal) modal.classList.add('hidden');
    };

    window.openPrintResi = function(filename) {
      if (!filename) return;
      const card = document.getElementById('checkIncludeCard')?.checked ? '1' : '0';
      const threshold = document.getElementById('selectResiThreshold')?.value || '180';
      window.open(`/print-resi?file=${encodeURIComponent(filename)}&card=${card}&threshold=${threshold}`, '_blank');
    };

    window.directPrintLatestResi = async function() {
      try {
        if (typeof window.showToast === 'function') {
          window.showToast('Memeriksa file resi terbaru...', 'info');
        }
        const res = await fetch('/api/resi/files');
        const data = await res.json();
        if (data && data.files && data.files.length > 0) {
          const latest = data.files[0].filename;
          if (typeof window.printResiBle === 'function') {
            await window.printResiBle(latest);
          } else {
            // Direct fetch fallback to thermal printer
            const includeCard = document.getElementById('checkIncludeCard')?.checked !== false;
            const threshold = Number(document.getElementById('selectResiThreshold')?.value || 180);
            const printRes = await fetch('/api/resi/print', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ filename: latest, include_card: includeCard, threshold: threshold })
            });
            const printData = await printRes.json();
            if (printData.status === 'success') {
              alert(`✅ Berhasil dicetak langsung ke Printer Thermal: ${latest}`);
            } else {
              alert(`⚠️ Gagal cetak ke thermal: ${printData.message}\n\nPastikan tombol power printer thermal RPP02N menyala dan Bluetooth aktif.`);
            }
          }
        } else {
          alert('Belum ada file resi PDF di folder resi/. Silakan download label dari Shopee Seller terlebih dahulu.');
        }
      } catch (err) {
        console.error(err);
        alert('Gagal mengirim resi ke printer thermal: ' + err.message);
      }
    };
  </script>

  <!-- Core App Logic -->
  <script is:inline src="/app.js?v=20261124"></script>
</Layout>
